# Development Dockerfile for React + Vite client with hot-reload
FROM node:20-alpine

# Set the working directory inside the container
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of the application
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Run Vite dev server with hot-reload
CMD ["npm", "run", "dev"]
